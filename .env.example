GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública de Next (la callback de Google pasa por su proxy)
PUBLIC_WEB_URL=http://localhost:3000
# URL de Express vista desde Next
API_INTERNAL_URL=http://localhost:4000

# -------------------------------------------------------------
# Configuración del Servicio de Correo (SMTP / Azure)
# -------------------------------------------------------------
# NOTA PARA AZURE: Azure bloquea el puerto 25 saliente por seguridad.
# Usa siempre el puerto 587 (STARTTLS) o el 465 (SSL con SMTP_SECURE=true).
#
# Ejemplos de proveedores comunes:
#
# 1. SendGrid (Recomendado en Azure Marketplace):
#    SMTP_HOST=smtp.sendgrid.net
#    SMTP_PORT=587
#    SMTP_USER=apikey
#    SMTP_PASS=<tu_sendgrid_api_key>
#
# 2. Azure Communication Services (ACS) Email / SMTP relay:
#    SMTP_HOST=smtp.azurecomm.net
#    SMTP_PORT=587
#    SMTP_USER=<acs_user>
#    SMTP_PASS=<acs_password>
#
# 3. Microsoft 365 / Outlook:
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USER=tu-correo@tudominio.com
#    SMTP_PASS=<app_password>
#
# 4. Brevo (Sendinblue):
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_USER=tu-login@brevo.com
#    SMTP_PASS=<tu_master_password>
#
# 5. Gmail / Google Workspace:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=tu-cuenta@gmail.com
#    SMTP_PASS=<contraseña_de_aplicacion_16_caracteres>
# -------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TallerPro <no-responder@tallerpro.es>
# Ignorar certificados autofirmados (solo en desarrollo / pruebas):
# SMTP_IGNORE_TLS=false

# Solo para entornos de pruebas: muestra el acceso sin Google en /login (necesita NODE_ENV=test en la API)
# NEXT_PUBLIC_ACCESO_PRUEBAS=1
