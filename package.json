{
  "name": "taller",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db db-test",
    "web:up": "docker compose up -d --build web",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test -w api",
    "test:docker": "docker compose --profile test run --rm test",
    "e2e": "playwright test",
    "dev:api": "npm run dev -w api",
    "dev:test:api": "NODE_ENV=test npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "emails:preview": "npm run emails:preview -w api",
    "email:test": "npm run email:test -w api",
    "mutaciones": "npm run mutaciones -w api",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "8.5.32",
    "prisma": "^5.22.0",
    "tsx": "4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
