{
  "name": "taller",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db db-test",
    "web:up": "docker compose up -d --build web",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test -w api",
    "test:docker": "docker compose --profile test run --rm test",
    "e2e": "playwright test",
    "dev:api": "npm run dev -w api",
    "dev:test:api": "NODE_ENV=test npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "emails:preview": "npm run emails:preview -w api",
    "email:test": "npm run email:test -w api",
    "mutaciones": "npm run mutaciones -w api"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "postcss": "8.5.32",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
